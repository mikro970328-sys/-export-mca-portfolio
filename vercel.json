{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/domain-router.html"
    },
    {
      "source": "/tracking",
      "destination": "/admin/index.html"
    },
    {
      "source": "/tracking/:path*",
      "destination": "/admin/index.html"
    }
  ]
}